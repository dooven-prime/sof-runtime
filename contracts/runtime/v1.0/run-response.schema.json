{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/runtime/v1.0/run-response.schema.json",
  "title": "SOF Evidence-Bus RunResponse v1",
  "description": "Execution status is distinct from finding result state and reader-facing claim status.",
  "type": "object",
  "required": [
    "schema_id",
    "semantic_run_id",
    "execution_id",
    "request_digest",
    "plugin",
    "carrier_kind",
    "status",
    "artifact_directory",
    "outputs",
    "artifact_closure",
    "validator",
    "failure",
    "diagnostics"
  ],
  "properties": {
    "schema_id": {"const": "sof.run-response.v1"},
    "semantic_run_id": {"type": "string", "pattern": "^semrun:sha256:[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "pattern": "^exec:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plugin": {
      "type": "object",
      "required": ["plugin_id", "plugin_version"],
      "properties": {
        "plugin_id": {"type": "string", "minLength": 1},
        "plugin_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "carrier_kind": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED_VALIDATION",
        "FAILED_EXECUTION",
        "PARTIAL",
        "CANCELLED",
        "UNSUPPORTED"
      ]
    },
    "artifact_directory": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "artifact_ref"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "artifact_ref": {"$ref": "#/$defs/artifact_ref"}
        },
        "additionalProperties": false
      }
    },
    "artifact_closure": {
      "type": "object",
      "required": [
        "closure_profile",
        "artifact_manifest_digest",
        "artifact_count",
        "ordered_artifact_ids",
        "artifacts",
        "validator_certificate_digest"
      ],
      "properties": {
        "closure_profile": {"const": "sof-artifact-closure-v1"},
        "artifact_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_count": {"type": "integer", "minimum": 1},
        "ordered_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "uniqueItems": true
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact_id", "kind", "media_type", "uri", "sha256", "schema_id", "producer", "input_refs"],
            "properties": {
              "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
              "kind": {"type": "string", "minLength": 1},
              "media_type": {"type": "string", "minLength": 1},
              "uri": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "schema_id": {"type": ["string", "null"]},
              "producer": {"type": "string", "minLength": 1},
              "input_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "validator_certificate_digest": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "validator": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["validator_id", "validator_version", "ran"],
          "properties": {
            "validator_id": {"type": "string", "minLength": 1},
            "validator_version": {"type": "string", "minLength": 1},
            "ran": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      ]
    },
    "failure": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/failure"}
      ]
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "media_type", "uri", "sha256", "schema_id", "producer", "input_refs"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "media_type": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_id": {"type": ["string", "null"]},
        "producer": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": [
        "stage",
        "error_type",
        "message",
        "stderr_sha256",
        "retryable",
        "generated_artifact_ids",
        "usable_finding_count",
        "validator_ran"
      ],
      "properties": {
        "stage": {
          "enum": [
            "INPUT_VALIDATION",
            "POLICY_ADMISSION",
            "PLUGIN_EXECUTION",
            "ARTIFACT_PERSISTENCE",
            "INDEPENDENT_VALIDATION",
            "RESPONSE_ASSEMBLY",
            "CANCELLATION"
          ]
        },
        "error_type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "stderr_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "retryable": {"type": "boolean"},
        "generated_artifact_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "usable_finding_count": {"type": "integer", "minimum": 0},
        "validator_ran": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]},
      "then": {
        "properties": {
          "outputs": {"minItems": 1},
          "failure": {"type": "null"},
          "validator": {
            "type": "object",
            "properties": {"ran": {"const": true}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"not": {"const": "SUCCEEDED"}}}, "required": ["status"]},
      "then": {"properties": {"failure": {"$ref": "#/$defs/failure"}}}
    }
  ],
  "additionalProperties": false
}
