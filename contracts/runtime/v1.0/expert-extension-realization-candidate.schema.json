{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rime-project.local/schemas/sof-runtime/expert-extension-realization-candidate-v1.0.schema.json",
  "title": "SOF Expert Extension Realization Candidate v1.0",
  "description": "A runtime-validated extension realization that is not eligible for canonical SOF compilation without upstream promotion.",
  "type": "object",
  "required": [
    "candidate_version",
    "candidate_kind",
    "source_id",
    "extension_contract",
    "payload",
    "negative_boundary"
  ],
  "properties": {
    "candidate_version": {"const": "1.0"},
    "candidate_kind": {"const": "extension_only"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "extension_contract": {
      "type": "object",
      "required": ["contract_id", "contract_version"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "contract_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "payload": {"type": "object"},
    "negative_boundary": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
