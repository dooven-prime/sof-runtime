{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/runtime/v1.0/coordinate-evaluator-registry.schema.json",
  "title": "SOF Runtime Coordinate Evaluator Registry v1",
  "type": "object",
  "required": ["registry_id", "registry_version", "evaluators", "negative_boundary"],
  "properties": {
    "registry_id": {"const": "sof-runtime.coordinate-evaluators.v1"},
    "registry_version": {"const": "1.0"},
    "evaluators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "coordinate-evaluator-declaration.schema.json"}
    },
    "negative_boundary": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
