{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/runtime/v1.0/plugin-manifest.schema.json",
  "title": "SOF Runtime Plugin Manifest v1",
  "type": "object",
  "required": ["schema_id", "plugin_id", "plugin_version", "execution_mode", "carrier_kind", "input_schema", "output_schema", "semantic_environment"],
  "properties": {
    "schema_id": {"const": "sof.plugin-manifest.v1"},
    "plugin_id": {"type": "string", "minLength": 1},
    "plugin_version": {"type": "string", "minLength": 1},
    "execution_mode": {"enum": ["python_in_process", "external_executable"]},
    "carrier_kind": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string", "minLength": 1},
    "semantic_environment": {
      "type": "object",
      "required": ["algorithm_mode", "arithmetic_backend", "dependency_lock_digest", "feature_flags"],
      "properties": {
        "algorithm_mode": {"type": "string", "minLength": 1},
        "arithmetic_backend": {"type": "string", "minLength": 1},
        "dependency_lock_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "feature_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "entry_point": {"type": "string", "minLength": 1},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_mode": {"const": "python_in_process"}}},
      "then": {"required": ["entry_point"], "not": {"required": ["command"]}}
    },
    {
      "if": {"properties": {"execution_mode": {"const": "external_executable"}}},
      "then": {"required": ["command"], "not": {"required": ["entry_point"]}}
    }
  ],
  "additionalProperties": false
}
