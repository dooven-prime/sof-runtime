{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/runtime/v1.0/promotion-package.schema.json",
  "title": "SOF Runtime Promotion Package v1",
  "type": "object",
  "required": [
    "schema_id",
    "package_id",
    "promotion_state",
    "semantic_run_id",
    "execution_ids",
    "run_response_artifact_closure_digest",
    "candidate",
    "artifact_refs",
    "validator",
    "requested_claim_status",
    "negative_evidence"
  ],
  "properties": {
    "schema_id": {"const": "sof.promotion-package.v1"},
    "package_id": {"type": "string", "minLength": 1},
    "promotion_state": {"const": "CANDIDATE"},
    "semantic_run_id": {"type": "string", "pattern": "^semrun:sha256:[0-9a-f]{64}$"},
    "execution_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^exec:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
      "uniqueItems": true
    },
    "run_response_artifact_closure_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "object",
      "required": ["extension_id", "extension_version", "proposed_carrier_kind", "semantics"],
      "properties": {
        "extension_id": {"type": "string", "minLength": 1},
        "extension_version": {"type": "string", "minLength": 1},
        "proposed_carrier_kind": {"type": "string", "minLength": 1},
        "semantics": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "validator": {
      "type": "object",
      "required": ["validator_id", "validator_version", "certificate_artifact_id"],
      "properties": {
        "validator_id": {"type": "string", "minLength": 1},
        "validator_version": {"type": "string", "minLength": 1},
        "certificate_artifact_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "requested_claim_status": {
      "enum": ["Theorem", "Computational Certificate", "Computational Observation", "Research Program"]
    },
    "negative_evidence": {
      "type": "object",
      "required": ["separation_statements", "known_counterexample_refs", "failed_promotion_attempt_refs", "excluded_regimes", "unsupported_policies"],
      "properties": {
        "separation_statements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "known_counterexample_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "failed_promotion_attempt_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "excluded_regimes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "unsupported_policies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["artifact_id", "media_type", "uri", "sha256", "schema_id", "producer", "input_refs"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "media_type": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_id": {"type": ["string", "null"]},
        "producer": {"type": "string", "minLength": 1},
        "input_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
