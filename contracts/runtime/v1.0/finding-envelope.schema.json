{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/runtime/v1.0/finding-envelope.schema.json",
  "title": "SOF Runtime Finding Envelope v1",
  "type": "object",
  "required": [
    "schema_id",
    "finding_id",
    "record_kind",
    "source_ref",
    "carrier_ref",
    "scope",
    "result_state",
    "claim_status",
    "value_ref",
    "policy_refs",
    "evidence_refs",
    "derivation_refs",
    "provenance"
  ],
  "properties": {
    "schema_id": {"const": "sof.finding.v1"},
    "finding_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "record_kind": {"enum": ["strict_sof", "diagnostic_analogue"]},
    "source_ref": {"type": "string", "minLength": 1},
    "carrier_ref": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["object_ids", "pair_scope", "depth_scope"],
      "properties": {
        "object_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "pair_scope": {"type": ["object", "null"]},
        "depth_scope": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "result_state": {
      "enum": ["DECLARED", "ESTABLISHED", "CERTIFIED", "OBSERVED", "UNREACHED_AT_CUTOFF", "NOT_APPLICABLE", "NOT_DECLARED"]
    },
    "claim_status": {
      "enum": ["Theorem", "Computational Certificate", "Computational Observation", "Research Program", null]
    },
    "value_ref": {"type": "string", "minLength": 1},
    "policy_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "derivation_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "provenance": {
      "type": "object",
      "required": ["producer", "producer_version", "semantic_run_id", "execution_id", "created_at"],
      "properties": {
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "semantic_run_id": {"type": "string", "pattern": "^semrun:sha256:[0-9a-f]{64}$"},
        "execution_id": {"type": "string", "pattern": "^exec:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result_state": {"const": "DECLARED"}}, "required": ["result_state"]},
      "then": {"properties": {"claim_status": {"enum": ["Research Program", null]}}}
    },
    {
      "if": {"properties": {"result_state": {"const": "ESTABLISHED"}}, "required": ["result_state"]},
      "then": {"properties": {"claim_status": {"const": "Theorem"}}}
    },
    {
      "if": {"properties": {"result_state": {"const": "CERTIFIED"}}, "required": ["result_state"]},
      "then": {"properties": {"claim_status": {"const": "Computational Certificate"}}}
    },
    {
      "if": {"properties": {"result_state": {"const": "OBSERVED"}}, "required": ["result_state"]},
      "then": {"properties": {"claim_status": {"const": "Computational Observation"}}}
    },
    {
      "if": {"properties": {"result_state": {"const": "UNREACHED_AT_CUTOFF"}}, "required": ["result_state"]},
      "then": {"properties": {"claim_status": {"enum": ["Computational Certificate", "Computational Observation"]}}}
    },
    {
      "if": {"properties": {"result_state": {"enum": ["NOT_APPLICABLE", "NOT_DECLARED"]}}, "required": ["result_state"]},
      "then": {"properties": {"claim_status": {"type": "null"}}}
    }
  ],
  "additionalProperties": false
}
