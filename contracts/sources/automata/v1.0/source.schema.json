{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/sources/automata/v1.0/source.schema.json",
  "title": "Complete Deterministic Automaton Source v1",
  "type": "object",
  "required": ["schema_id", "source_id", "states", "alphabet", "transitions"],
  "properties": {
    "schema_id": {"const": "rime.automata.source.v1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "states": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "alphabet": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
