{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/extensions/positive-word-support/v1.0/certificate.schema.json",
  "title": "Single-Letter Positive-Word Support Certificate v1",
  "type": "object",
  "required": ["schema_id", "certificate_id", "semantic_run_id", "execution_id", "validator_id", "validator_version", "validator_independence", "status", "scope", "applicability", "input_digests", "checks", "recomputed"],
  "properties": {
    "schema_id": {"const": "rime.positive-word-support.certificate.v1"},
    "certificate_id": {"type": "string", "minLength": 1},
    "semantic_run_id": {"type": "string", "pattern": "^semrun:sha256:[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "pattern": "^exec:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "validator_id": {"type": "string", "minLength": 1},
    "validator_version": {"type": "string", "minLength": 1},
    "validator_independence": {
      "type": "object",
      "required": ["implementation_relation", "language_relation", "runtime_relation", "input_source", "producer_cache_used"],
      "properties": {
        "implementation_relation": {"const": "separate_algorithm"},
        "language_relation": {"enum": ["same_language", "different_language", "unknown_language"]},
        "runtime_relation": {"enum": ["same_process", "separate_process", "separate_machine"]},
        "input_source": {"const": "canonical_source_artifacts"},
        "producer_cache_used": {"const": false}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "scope": {"type": "string", "minLength": 1},
    "applicability": {
      "type": "object",
      "required": ["alphabet_scope", "coefficient_scope", "arithmetic", "positivity_rule", "graph_equivalence", "excluded_regimes"],
      "properties": {
        "alphabet_scope": {"const": "single_letter"},
        "coefficient_scope": {"const": "entrywise_nonnegative"},
        "arithmetic": {"const": "exact_rational"},
        "positivity_rule": {"const": "strict_numerator_gt_zero"},
        "graph_equivalence": {"const": "support_graph_path_iff_positive_matrix_power_entry"},
        "excluded_regimes": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "input_digests": {
      "type": "object",
      "required": ["source", "bundle", "policy", "request"],
      "properties": {
        "source": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bundle": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "recomputed": {
      "type": "object",
      "required": ["reachable_pair_count", "unreachable_pair_count", "maximum_first_hit_depth", "errors"],
      "properties": {
        "reachable_pair_count": {"type": "integer", "minimum": 0},
        "unreachable_pair_count": {"type": "integer", "minimum": 0},
        "maximum_first_hit_depth": {"type": ["integer", "null"], "minimum": 1},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
