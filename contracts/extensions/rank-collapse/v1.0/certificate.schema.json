{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/extensions/rank-collapse/v1.0/certificate.schema.json",
  "title": "Rank-Collapse Validation Certificate v1",
  "type": "object",
  "required": ["schema_id", "certificate_id", "semantic_run_id", "execution_id", "validator_id", "validator_version", "validator_independence", "status", "scope", "input_digests", "checks", "recomputed"],
  "properties": {
    "schema_id": {"const": "rime.rank-collapse.certificate.v1"},
    "certificate_id": {"type": "string", "minLength": 1},
    "semantic_run_id": {"type": "string", "pattern": "^semrun:sha256:[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "pattern": "^exec:[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "validator_id": {"type": "string", "minLength": 1},
    "validator_version": {"type": "string", "minLength": 1},
    "validator_independence": {
      "type": "object",
      "required": ["implementation_relation", "language_relation", "runtime_relation", "input_source", "producer_cache_used"],
      "properties": {
        "implementation_relation": {"enum": ["separate_implementation", "same_implementation_replay", "cross_language_implementation"]},
        "language_relation": {"enum": ["same_language", "different_language", "unknown_language"]},
        "runtime_relation": {"enum": ["same_process", "separate_process", "separate_machine"]},
        "input_source": {"enum": ["canonical_source_artifacts", "in_memory_values"]},
        "producer_cache_used": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "scope": {"type": "string", "minLength": 1},
    "input_digests": {
      "type": "object",
      "required": ["source", "bundle", "policy", "request"],
      "properties": {
        "source": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bundle": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "request": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "recomputed": {
      "type": "object",
      "required": ["reachable_image_subset_count", "first_hit_depth_by_rank_threshold", "errors"],
      "properties": {
        "reachable_image_subset_count": {"type": "integer", "minimum": 1},
        "first_hit_depth_by_rank_threshold": {"type": "object", "additionalProperties": {"type": ["integer", "null"], "minimum": 0}},
        "errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
