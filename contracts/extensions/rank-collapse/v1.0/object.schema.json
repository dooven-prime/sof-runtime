{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sof-runtime.local/contracts/extensions/rank-collapse/v1.0/object.schema.json",
  "title": "Rank-Collapse Object v1",
  "type": "object",
  "required": ["schema_id", "object_id", "source_ref", "state_count", "alphabet_labels", "semantics"],
  "properties": {
    "schema_id": {"const": "rime.rank-collapse.object.v1"},
    "object_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "state_count": {"type": "integer", "minimum": 1},
    "alphabet_labels": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "semantics": {"const": "exact image subsets of positive deterministic words"}
  },
  "additionalProperties": false
}
